# ==============================================================================
# Deepfake Video Detection — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your optional API keys and settings:
#   cp .env.example .env
#
# Note: The system runs 100% locally and offline without external dependencies.
# The Groq API key is optional and is only used to generate natural language
# executive forensic briefings. If not provided, a deterministic, evidence-grounded
# safe fallback report is generated automatically.
# ==============================================================================

# Optional: Groq API Key for AI Forensic Analyst narrative briefings
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Preferred Groq model (default fallback cascade: openai/gpt-oss-120b, qwen/qwen3-32b)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Serving Host & Port
HOST=127.0.0.1
PORT=8000

