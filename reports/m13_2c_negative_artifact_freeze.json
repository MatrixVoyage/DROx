{
  "milestone": "13.2c",
  "name": "Identity/Manipulation Disentanglement Negative Experimental Baseline Freeze",
  "frozen_at": "2026-09-25T03:32:00Z",
  "status": "REJECTED_AS_GENERALIZATION_SOLUTION",
  "scientific_verdict": {
    "verdict": "REJECTED",
    "primary_finding": "Explicit identity/manipulation subspace disentanglement does not produce statistically significant ranking improvements on held-out Face2Face reenactments beyond M13.2b-Stage5.",
    "causal_disconfirmation": "Shuffled-group negative control (random group assignments) performed identically to true group supervision (ROC-AUC: 0.7797 vs 0.7723; detection rate: 53.45% vs 53.45%), proving that identity contrastive loss provides no causal domain-invariance to unseen facial manipulations.",
    "generalization_penalty": "All disentangled models suffered severe cross-dataset collapse on Celeb-DF v2 (ROC-AUC collapsed from 0.7599 down to 0.6597-0.6878), and TrueGroup suffered severe clean real specificity degradation (FRR spiked from 9.18% to 15.31%).",
    "representation_leakage": "Post-hoc linear probes show extensive manipulation signal leaking into z_id (AUC 0.7570-0.8343), and identity similarity DeltaSim remaining higher in z_manip than in z_id (+0.41 to +0.47 vs +0.12 to +0.22)."
  },
